# เลือก AI ที่ใช้: openai หรือ claude
AI_PROVIDER=openai

# คีย์ OpenAI (สร้างได้ที่ https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-terra

# คีย์ Claude (สร้างได้ที่ https://platform.claude.com/settings/keys) — ใช้เมื่อ AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# ชื่อกลุ่มที่ให้บอทสรุป คั่นด้วยจุลภาค (เว้นว่าง = ทุกกลุ่มที่บอทอยู่)
WATCH_GROUPS=EXAMPLE STUDIO

# เวลาสรุปอัตโนมัติ (รูปแบบ cron) เว้นว่างเพื่อปิด  ตัวอย่าง: 0 18 * * * = ทุกวัน 18:00
SUMMARY_CRON=0 18 * * *
TZ_NAME=Asia/Bangkok

# ชื่อของเจ้าของเบอร์ที่สแกน QR (ใช้แทนคำว่า "ฉัน" ในสรุป)
MY_NAME=

# ส่งสรุปอัตโนมัติไปที่ไหน: group = โพสต์ในกลุ่ม, owner = ส่งแชทส่วนตัวหา OWNER_NUMBER
SUMMARY_TARGET=group
OWNER_NUMBER=

# ล็อกอินด้วยรหัสจับคู่แทนการสแกน QR (ใส่เบอร์ของบอท พร้อมรหัสประเทศ เช่น 66812345678)
PAIRING_NUMBER=

# ให้ AI ดูรูปและ PDF ที่ส่งในกลุ่ม (true/false)
DESCRIBE_MEDIA=true

# อธิบายทีมสั้นๆ ให้ AI เข้าใจบริบท
GROUP_CONTEXT=ทีมออกแบบสถาปัตยกรรม 3 คน: Nok คุยกับลูกค้าและแก้แบบ, Somchai ทำ Render และกราฟิก/โลโก้ คุยเรื่องงานลูกค้า แบบบ้าน Render แบรนด์ และไฟล์งานใน Google Drive

# โมเดล Claude (ค่าเริ่มต้น claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# --- งานและการเตือน ---
# สรุปงานตอนเช้า (cron) เว้นว่างเพื่อปิด
BRIEFING_CRON=0 8 * * *
# ให้บอทจดงานจากแชทเอง และโพสต์แจ้งเมื่อจดหรือปิดงาน
AUTO_TASKS=true
ANNOUNCE_TASKS=true
# ทวงงานซ้ำกี่ครั้ง และห่างกันกี่ชั่วโมง
MAX_NAGS=2
NAG_HOURS=3
# คำที่ใช้เรียกบอท นอกจากการแท็ก
BOT_NAMES=บอท,botty,bot
